# ── Auth ─────────────────────────────────────────────────────
# The single password for the app. There is no registration and no user list.
APP_PASSWORD=change-me

# Signs the session cookie. Any long random string:
#   openssl rand -base64 48
# Changing it logs you out. Nothing else depends on it.
SESSION_SECRET=change-me-too

# Set to true only if you terminate TLS in front of the app. Leaving it false
# behind plain HTTP on a LAN is correct — a Secure cookie over HTTP is dropped
# by the browser and you will not be able to log in.
COOKIE_SECURE=false

# ── Nano-GPT (FUEL photo analysis — Phase 3) ─────────────────
NANOGPT_API_KEY=
NANOGPT_BASE_URL=https://nano-gpt.com/api/v1

# Starting vision model. This is only a fallback — Settings in the app lists
# every vision-capable model with live prices, has a search box, and overrides
# whatever is set here with no restart. Leave it blank and pick in the UI.
#
# You said Gemma 4 has been working well, so search "gemma" in Settings and tap
# it. Exact IDs differ by provider, which is why this ships blank rather than
# guessing one that would silently 404 on the first photo.
NANOGPT_VISION_MODEL=

# ── Runtime ──────────────────────────────────────────────────
# Host port. The container always listens on 3000, so changing this needs no
# rebuild — edit and run `docker compose up -d`.
ARACHNE_PORT=3000
TZ=Europe/Berlin

# The hour a day turns over, in local time. Not midnight: logging water or
# ticking a chore at 01:00 belongs to the day you have not finished yet. 4
# covers an ordinary late night; raise it if you are reliably up later. 0
# restores the midnight boundary. Shown in SETTINGS so you can check what the
# running build is actually doing.
DAY_START_HOUR=4

# Only used outside Docker. Compose sets these itself.
# DATABASE_PATH=./data/db/arachne.db
# UPLOAD_DIR=./data/uploads
