# ── Auth ─────────────────────────────────────────────────────
# The single password for the app. There is no registration and no user list.
APP_PASSWORD=change-me

# Signs the session cookie. Any long random string:
#   openssl rand -base64 48
# Changing it logs you out. Nothing else depends on it.
SESSION_SECRET=change-me-too

# Set to true only if you terminate TLS in front of the app. Leaving it false
# behind plain HTTP on a LAN is correct — a Secure cookie over HTTP is dropped
# by the browser and you will not be able to log in.
COOKIE_SECURE=false

# ── Nano-GPT (FUEL photo analysis — Phase 3) ─────────────────
NANOGPT_API_KEY=
NANOGPT_BASE_URL=https://nano-gpt.com/api/v1

# Starting vision model. This is only the fallback — Settings in the app shows
# the live model list with prices and overrides whatever is set here, with no
# restart. Leave it blank and pick one in the UI if you prefer.
#
# Recommended default: cheapest per image, fastest, reliable structured JSON.
# "Photo to rough macros" is a low-difficulty vision task; latency and cost are
# the binding constraints, not reasoning depth.
NANOGPT_VISION_MODEL=gemini-2.5-flash-lite

# ── Runtime ──────────────────────────────────────────────────
# Host port. The container always listens on 3000, so changing this needs no
# rebuild — edit and run `docker compose up -d`.
ARACHNE_PORT=3000
TZ=Europe/Berlin

# Only used outside Docker. Compose sets these itself.
# DATABASE_PATH=./data/db/arachne.db
# UPLOAD_DIR=./data/uploads
